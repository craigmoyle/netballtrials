  "narrative": {
    "northStar": "The Sideline Clipboard",
    "overview": "The interface is a calm, practical clipboard for match day: committee members can scan registrations, court assignments and player numbers quickly, while families get clear next steps on a phone. The Chisholm wordmark and blue-and-plum palette provide recognition; the rest of the interface stays straightforward so trial information leads.\n\nPublic pages are welcoming and reassuring. Admin pages favor clear status, compact workflows and explainable data. Printed selectors carry the same hierarchy onto paper, with strong grids, writable fields and team-color names that remain useful in grayscale.",
    "keyCharacteristics": [
      "Operational, task-first layouts with familiar controls.",
      "Blue surfaces identify the club shell; plum identifies actions and links.",
      "Data tables and print sheets prioritize legibility over decoration.",
      "A single system sans-serif voice across screens and forms."
    ],
    "rules": [
      { "name": "The Written Color Rule", "body": "A team-color swatch always appears with its written name. Grayscale printing must not remove the distinction between teams.", "section": "colors" },
      { "name": "The One Accent Rule", "body": "Deep Plum carries the main action; Chisholm Blue belongs to the shell and broad club surfaces. Keep both purposeful.", "section": "colors" },
      { "name": "The Single Voice Rule", "body": "Do not introduce a display font or an unrelated type family; the interface uses one system sans-serif stack.", "section": "typography" },
      { "name": "The Flat Surface Rule", "body": "Use borders and tonal surfaces for structure; do not add shadows to controls or panels.", "section": "elevation" }
    ],
    "dos": [
      "Do preserve the supplied club wordmark and its white backing.",
      "Do use Number for a player's assigned identifier; reserve “bib color” for team uniforms.",
      "Do pair each team-color swatch with its written name.",
      "Do retain visible keyboard focus and text labels for statuses.",
      "Do keep the public form calm and the Admin tables dense but readable."
    ],
    "donts": [
      "Don't use color as the only team identifier.",
      "Don't add decorative photography, remote fonts or unprovided brand assets.",
      "Don't add drop shadows, gradients or rounded-card scaffolding to the otherwise flat interface.",
      "Don't treat the legacy browser theme-color metadata as the canonical plum for interface components."
    ]
  }
