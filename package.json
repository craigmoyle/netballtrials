{
  "name": "netball-trials",
  "private": true,
  "version": "0.1.0",
  "description": "Netball trials registration, check-in, and round planning",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev:api": "npm run dev --workspace @netball-trials/api",
    "dev:web": "npm run dev --workspace @netball-trials/web",
    "test": "npm run test --workspaces --if-present",
    "test:e2e": "npm run test:e2e --workspace @netball-trials/web",
    "admin:bootstrap": "npm run admin:bootstrap --workspace=@netball-trials/api",
    "seed:test-dataset": "npm run seed:test-dataset --workspace=@netball-trials/api",
    "send-reminders": "npm run send-reminders --workspace=@netball-trials/api",
    "retention": "npm run retention --workspace=@netball-trials/api",
    "build": "npm run build --workspaces --if-present"
  },
  "overrides": {
    "effect": "3.22.1"
  },
  "allowScripts": {
    "prisma@7.10.1": true,
    "@prisma/engines@7.10.1": true,
    "esbuild@0.28.2": true
  }
}
