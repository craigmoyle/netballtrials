# Local development only. Production must set real Stripe credentials, a secure
# cookie, the public web origin, and NODE_ENV=production.
DATABASE_URL=postgresql://postgres:postgres@localhost:55432/netballtrials
NODE_ENV=development
PAYMENT_PROVIDER=fake
WEB_ORIGIN=http://localhost:5173
API_PUBLIC_URL=http://localhost:3000
# Comma-separated trusted proxy IPs/CIDRs; leave empty when directly exposed.
TRUST_PROXY=
SESSION_COOKIE_SECURE=false
MAIL_FROM=chisholmnetball@gmail.com
MAIL_REPLY_TO=chisholmnetball@gmail.com
# Gmail API OAuth offline refresh credentials (production only)
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PORT=3000
