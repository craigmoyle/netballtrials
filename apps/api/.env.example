# Local development only. Production must configure Stripe/Gmail (preferably in
# Infisical), a secure cookie, public origins, and NODE_ENV=production.
DATABASE_URL=postgresql://postgres:postgres@localhost:55432/netballtrials
NODE_ENV=development
PAYMENT_PROVIDER=fake
WEB_ORIGIN=http://localhost:5173
API_PUBLIC_URL=http://localhost:3000
# Comma-separated trusted proxy IPs/CIDRs; leave empty when directly exposed.
TRUST_PROXY=
SESSION_COOKIE_SECURE=false
MAIL_FROM=chisholmnetball@gmail.com
MAIL_REPLY_TO=chisholmnetball@gmail.com
# Gmail API OAuth offline refresh credentials (production only)
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Keep these Universal Auth bootstrap credentials in deployment secret settings.
# The Admin UI changes only non-secret Infisical connection metadata.
# Scope the machine identity to this project, environment and secret path.
INFISICAL_API_URL=https://us.infisical.com
INFISICAL_UNIVERSAL_AUTH_CLIENT_ID=
INFISICAL_UNIVERSAL_AUTH_CLIENT_SECRET=
INFISICAL_PROJECT_ID=
INFISICAL_ENVIRONMENT=prod
INFISICAL_SECRET_PATH=/netball-trials
PORT=3000
