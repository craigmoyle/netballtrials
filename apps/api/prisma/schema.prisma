generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum StaffRole {
  ADMIN
}

model StaffUser {
  id          String       @id @default(cuid())
  email       String       @unique
  role        StaffRole    @default(ADMIN)
  createdAt   DateTime     @default(now())
  loginTokens LoginToken[]
  sessions    Session[]
}

model LoginToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      StaffUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Session {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  createdAt DateTime  @default(now())
  user      StaffUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

enum EventStatus {
  DRAFT
  OPEN
  CLOSED
}

model Event {
  id                   String      @id @default(cuid())
  name                 String
  competitionYear      Int
  division             String
  section              String
  eventDate            DateTime    @db.Date
  venue                String
  startTime            String
  endTime              String
  firstWhistle         String
  lastWhistle          String
  registrationFeeCents Int
  courts               Int
  rank1Min             Int
  rank2Min             Int
  rank3Min             Int
  playMinutes          Int         @default(8)
  changeoverMinutes    Int         @default(2)
  minAge               Int         @default(5)
  maxAge               Int         @default(99)
  checkInPinHash       String?
  checkInPinUpdatedAt  DateTime?
  nextBibNumber        Int         @default(1)
  checkInClosedAt      DateTime?
  policyUrl            String?
  policyDocumentName   String?
  status               EventStatus @default(DRAFT)
  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt
  registrations        Registration[]
  checkInSessions      CheckInSession[]
  roundPlans           RoundPlan[]
}

model MemberAssociation {
  id     String  @id @default(cuid())
  name   String  @unique
  active Boolean @default(true)
}

enum Position {
  GS
  GA
  WA
  C
  WD
  GD
  GK
}

enum RegistrationStatus {
  PENDING
  PAID
  EXPIRED
  FAILED
  WITHDRAWN
}

model Registration {
  id                     String             @id @default(cuid())
  eventId                String
  event                  Event              @relation(fields: [eventId], references: [id], onDelete: Cascade)
  playerFirstName        String
  playerLastName         String
  playerNameNormalized   String
  dateOfBirth            DateTime           @db.Date
  parentName             String
  parentEmail            String
  parentMobile           String
  memberAssociation      String
  rank1Position          Position
  rank2Position          Position?
  rank3Position          Position?
  optInExtraPositions    Boolean            @default(false)
  eligibilityConfirmedAt DateTime
  policyReference        String
  status                 RegistrationStatus @default(PENDING)
  ageFlagged             Boolean            @default(false)
  amountCents            Int
  currency               String             @default("aud")
  paymentRef             String?
  paidAt                 DateTime?
  qrToken                String?            @unique
  bibNumber              Int?
  checkedInAt            DateTime?
  checkedInBy            String?
  expiresAt              DateTime
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt

  @@index([eventId, status])
}

model CheckInSession {
  id        String   @id @default(cuid())
  eventId   String
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([eventId])
}

enum PlanStatus {
  DRAFT
  PUBLISHED
}

model RoundPlan {
  id                String      @id @default(cuid())
  eventId           String
  event             Event       @relation(fields: [eventId], references: [id], onDelete: Cascade)
  seed              Int
  status            PlanStatus  @default(DRAFT)
  rounds            Int
  playMinutes       Int
  changeoverMinutes Int
  createdAt         DateTime    @default(now())
  publishedAt       DateTime?
  slots             RoundSlot[]

  @@index([eventId])
}

model RoundSlot {
  id             String    @id @default(cuid())
  planId         String
  plan           RoundPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  round          Int
  court          Int
  position       Position
  team           Int
  registrationId String

  @@index([planId, round])
}
