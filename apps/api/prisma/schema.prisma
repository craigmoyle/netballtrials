generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum StaffRole {
  ADMIN
}

model StaffUser {
  id                String       @id @default(cuid())
  email             String       @unique
  role              StaffRole    @default(ADMIN)
  invitedByUserId   String?
  invitedBy         StaffUser?   @relation("AdminInvitations", fields: [invitedByUserId], references: [id], onDelete: SetNull)
  invitees          StaffUser[]  @relation("AdminInvitations")
  createdAt         DateTime     @default(now())
  loginTokens       LoginToken[]
  sessions          Session[]
  emailDeliveries   EmailLog[]    @relation("EmailLogSender")
  scheduledMessages ScheduledMessage[] @relation("ScheduledMessageSender")
}

model LoginToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      StaffUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Session {
  id              String          @id @default(cuid())
  userId          String
  tokenHash       String          @unique
  expiresAt       DateTime
  createdAt       DateTime        @default(now())
  user            StaffUser       @relation(fields: [userId], references: [id], onDelete: Cascade)
  checkInSessions CheckInSession[]

  @@index([userId])
}

enum EventStatus {
  DRAFT
  OPEN
  CLOSED
}

model Event {
  id                   String      @id @default(cuid())
  name                 String
  competitionYear      Int
  division             String
  section              String
  eventDate            DateTime    @db.Date
  venue                String
  startTime            String
  endTime              String
  gameStartTime        String
  registrationFeeCents Int
  courts               Int
  rank1Min             Int
  rank2Min             Int
  rank3Min             Int
  playMinutes          Int         @default(8)
  changeoverMinutes    Int         @default(2)
  minAge               Int         @default(5)
  maxAge               Int         @default(99)
  checkInPinHash       String?
  checkInPinUpdatedAt  DateTime?
  checkInPinVersion    Int         @default(0)
  nextBibNumber        Int         @default(1)
  checkInClosedAt      DateTime?
  policyUrl            String?
  policyDocumentName   String?
  status               EventStatus @default(DRAFT)
  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt
  registrations        Registration[]
  checkInSessions      CheckInSession[]
  roundPlans           RoundPlan[]
  reviewItems          ReviewItem[]
  emailLogs            EmailLog[]
  scheduledMessages    ScheduledMessage[]
  courtColors          EventCourtColor[]
  policyDocument       EventPolicyDocument?
  publishedPlanId      String?
  publishedPlan        RoundPlan?    @relation("PublishedPlan", fields: [publishedPlanId], references: [id], onDelete: SetNull)
}

model EventPolicyDocument {
  eventId    String   @id
  event      Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  fileName   String
  bytes      Bytes
  uploadedAt DateTime @default(now())
}

model MemberAssociation {
  id                   String  @id @default(cuid())
  name                 String  @unique
  primaryContactName   String?
  primaryContactEmail  String?
  active               Boolean   @default(true)
  emailLogs            EmailLog[]
}

model EmailTemplate {
  id          String   @id @default(cuid())
  name        String   @unique
  audience    String
  subject     String
  body        String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  scheduledMessages ScheduledMessage[]
}

enum ScheduledMessageStatus {
  SCHEDULED
  SENDING
  COMPLETED
  CANCELLED
  FAILED
}

model ScheduledMessage {
  id            String                 @id @default(cuid())
  eventId       String
  event         Event                  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  senderUserId  String?
  sender        StaffUser?             @relation("ScheduledMessageSender", fields: [senderUserId], references: [id], onDelete: SetNull)
  templateId    String?
  template      EmailTemplate?         @relation(fields: [templateId], references: [id], onDelete: SetNull)
  audience      String
  recipientIds  Json
  batchId       String                 @unique
  subject       String
  body          String
  policyAttachment Json?
  scheduledAt   DateTime
  status        ScheduledMessageStatus @default(SCHEDULED)
  attempts      Int                    @default(0)
  lastAttemptAt DateTime?
  completedAt   DateTime?
  error         String?
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt

  @@index([status, scheduledAt])
  @@index([eventId, scheduledAt])
}

model BibColor {
  id          String            @id @default(cuid())
  name        String            @unique
  hex         String
  archivedAt  DateTime?
  createdAt   DateTime          @default(now())
  teamACourts EventCourtColor[] @relation("TeamAColor")
  teamBCourts EventCourtColor[] @relation("TeamBColor")
}

model EventCourtColor {
  eventId      String
  court        Int
  teamAColorId String
  teamBColorId String
  event        Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  teamAColor   BibColor @relation("TeamAColor", fields: [teamAColorId], references: [id], onDelete: Restrict)
  teamBColor   BibColor @relation("TeamBColor", fields: [teamBColorId], references: [id], onDelete: Restrict)

  @@id([eventId, court])
  @@index([teamAColorId])
  @@index([teamBColorId])
}

enum Position {
  GS
  GA
  WA
  C
  WD
  GD
  GK
}

enum RegistrationStatus {
  PENDING
  PAID
  EXPIRED
  FAILED
  WITHDRAWN
}

enum ParentAccessTokenPurpose {
  REGISTRATION_VERIFY
  SIGN_IN
  EMAIL_CHANGE
}

model Registration {
  id                     String             @id @default(cuid())
  eventId                String
  event                  Event              @relation(fields: [eventId], references: [id], onDelete: Cascade)
  playerFirstName        String
  playerLastName         String
  playerNameNormalized   String
  dateOfBirth            DateTime           @db.Date
  parentName             String
  parentEmail            String
  parentMobile           String
  memberAssociation      String
  rank1Position          Position
  rank2Position          Position?
  rank3Position          Position?
  optInExtraPositions    Boolean            @default(false)
  eligibilityConfirmedAt DateTime
  parentAuthorityConfirmedAt DateTime?
  parentEmailVerifiedAt   DateTime?
  parentFollowUpSentAt    DateTime?
  policyReference        String
  status                 RegistrationStatus @default(PENDING)
  statusBeforeAnonymization RegistrationStatus?
  anonymizedAt           DateTime?
  anonymizedRef          String?            @unique
  ageFlagged             Boolean            @default(false)
  amountCents            Int
  currency               String             @default("aud")
  checkoutSessionId      String?            @unique
  paymentIntentId        String?            @unique
  legacyPaymentRef       String?
  paidAt                 DateTime?
  qrToken                String?            @unique
  bibNumber              Int?
  checkedInAt            DateTime?
  checkedInBy            String?
  expiresAt              DateTime
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt

  reviewItems            ReviewItem[]
  emailLogs              EmailLog[]
  parentAccessTokens     ParentAccessToken[]
  changeLog              RegistrationChangeLog[]

  @@index([eventId, status])
  @@index([parentEmail, parentEmailVerifiedAt])
}

model ParentAccessToken {
  id             String                   @id @default(cuid())
  email          String
  newEmail       String?
  purpose        ParentAccessTokenPurpose
  registrationId String?
  registration   Registration?             @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  tokenHash      String                   @unique
  expiresAt      DateTime
  usedAt         DateTime?
  createdAt      DateTime                 @default(now())

  @@index([email, purpose, expiresAt])
  @@index([registrationId])
}

model ParentAccessSession {
  id        String   @id @default(cuid())
  email     String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([email, expiresAt])
}

model RegistrationChangeLog {
  id            String       @id @default(cuid())
  registrationId String
  registration  Registration @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  actorType     String       @default("PARENT")
  changedFields Json
  createdAt     DateTime     @default(now())

  @@index([registrationId, createdAt])
}

model ProcessedStripeEvent {
  stripeEventId String   @id
  eventType     String
  outcome       String
  createdAt     DateTime @default(now())

  @@index([createdAt])
}

model RequestRateLimitBucket {
  key             String   @id
  windowStartedAt DateTime
  hits            Int
  updatedAt       DateTime

  @@index([updatedAt])
}

model CheckInSession {
  id             String   @id @default(cuid())
  eventId        String
  event          Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  tokenHash      String   @unique
  pinVersion     Int      @default(0)
  adminSessionId String?
  adminSession   Session? @relation(fields: [adminSessionId], references: [id], onDelete: Cascade)
  expiresAt      DateTime
  createdAt      DateTime @default(now())

  @@index([eventId])
  @@index([adminSessionId])
}

enum PlanStatus {
  DRAFT
  PUBLISHED
}

model RoundPlan {
  id                String            @id @default(cuid())
  eventId           String
  event             Event             @relation(fields: [eventId], references: [id], onDelete: Cascade)
  activeForEvents   Event[]           @relation("PublishedPlan")
  revision          Int               @default(1)
  sourcePlanId      String?
  frozenThroughRound Int              @default(0)
  seed              Int
  status            PlanStatus        @default(DRAFT)
  rounds            Int
  courts            Int               @default(1)
  playMinutes       Int
  changeoverMinutes Int
  windowMinutes     Int               @default(1)
  rank1Min          Int               @default(0)
  rank2Min          Int               @default(0)
  rank3Min          Int               @default(0)
  eventName         String            @default("")
  eventDate         DateTime          @default(dbgenerated("'1900-01-01'::date")) @db.Date
  venue             String            @default("")
  gameStartTime     String            @default("00:00")
  createdAt         DateTime          @default(now())
  publishedAt       DateTime?
  validationWarnings Json              @default("[]")
  slots             RoundSlot[]
  players           RoundPlanPlayer[]

  @@unique([eventId, revision])
  @@index([eventId])
}

model RoundPlanPlayer {
  planId               String
  plan                 RoundPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  registrationId      String
  playerName          String
  bibNumber           Int?
  rank1Position       Position
  rank2Position       Position?
  rank3Position       Position?
  optInExtraPositions Boolean
  active              Boolean   @default(true)

  @@id([planId, registrationId])
  @@index([registrationId])
}

model RoundSlot {
  id             String    @id @default(cuid())
  planId         String
  plan           RoundPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  round          Int
  court          Int
  position       Position
  team           Int
  registrationId String

  @@unique([planId, round, court, position, team])
  @@unique([planId, round, registrationId])
  @@index([planId, round])
}

model ReviewItem {
  id               String       @id @default(cuid())
  eventId          String
  event            Event        @relation(fields: [eventId], references: [id], onDelete: Cascade)
  registrationId   String
  registration     Registration @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  reason           String
  note             String?
  resolvedAt       DateTime?
  resolvedByUserId String?
  resolutionHistory Json?
  createdAt        DateTime     @default(now())

  @@unique([registrationId, reason])
  @@index([eventId])
  @@index([registrationId])
}

enum EmailDeliveryState {
  PENDING
  SENDING
  SENT
  FAILED
  AMBIGUOUS
  ANONYMIZED
}

model EmailLog {
  id             String              @id @default(cuid())
  eventId        String
  event          Event               @relation(fields: [eventId], references: [id], onDelete: Cascade)
  registrationId String?
  registration   Registration?       @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  associationId  String?
  association    MemberAssociation?  @relation(fields: [associationId], references: [id], onDelete: SetNull)
  senderUserId   String?
  sender         StaffUser?          @relation("EmailLogSender", fields: [senderUserId], references: [id], onDelete: SetNull)
  batchId        String
  idempotencyKey String              @unique
  to             String
  subject        String
  kind           String
  body           String
  messagePayload Json?
  status         EmailDeliveryState  @default(PENDING)
  attempts       Int                 @default(0)
  lastAttemptAt  DateTime?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @default(now()) @updatedAt
  sentAt         DateTime?
  failedAt       DateTime?
  error          String?

  @@index([eventId, sentAt])
  @@index([batchId, status])
}
