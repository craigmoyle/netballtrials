FROM node:25-bookworm-slim@sha256:81db02c4b671288a03915da9534dbd54f96d0e7c24d80ccc54f5b36b2e684370 AS build
WORKDIR /app
COPY . .
RUN npm ci --workspace=@netball-trials/web --workspace=@netball-trials/types --include-workspace-root
ARG VITE_API_URL=
ENV VITE_API_URL=${VITE_API_URL}
RUN npm run build --workspace=@netball-trials/web

FROM caddy:2@sha256:4851e54a46b206517c574821bb5cc67f170d2156041e9fbc4c9193b45e84a75b
COPY --from=build /app/apps/web/dist /srv/trials
COPY deploy/vps/Caddyfile.web /etc/caddy/Caddyfile
