# Trials env file: /opt/netball/trials.env (root-only, mode 0600).
# Role passwords must match the platform env file. Keep provider credentials in Infisical.
TRIALS_DOMAIN=trials-test.statsball.net
# Admin mailboxes must use MFA; sign-in links are the Admin authentication factor.
TRIALS_DB_PASSWORD=
TRIALS_RUNTIME_DB_PASSWORD=
PAYMENT_PROVIDER=fake
ENABLE_TEST_INTEGRATIONS=false
INFISICAL_API_URL=https://us.infisical.com
INFISICAL_UNIVERSAL_AUTH_CLIENT_ID=
INFISICAL_UNIVERSAL_AUTH_CLIENT_SECRET=
INFISICAL_PROJECT_ID=
INFISICAL_ENVIRONMENT=test
INFISICAL_SECRET_PATH=/
