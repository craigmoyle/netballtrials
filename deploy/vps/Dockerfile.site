FROM node:24-bookworm-slim AS trials-web
WORKDIR /work/netballtrials
COPY netballtrials/ ./
RUN npm ci --workspace=@netball-trials/web --workspace=@netball-trials/types --include-workspace-root
ARG VITE_API_URL=
ENV VITE_API_URL=${VITE_API_URL}
RUN npm run build --workspace=@netball-trials/web

FROM node:24-bookworm-slim AS stats-web
WORKDIR /work/netballstats
COPY netballstats/ ./
RUN npm ci
RUN npm run build

FROM caddy:2
COPY --from=trials-web /work/netballtrials/apps/web/dist /srv/trials
COPY --from=stats-web /work/netballstats/dist /srv/stats
COPY netballtrials/deploy/vps/Caddyfile /etc/caddy/Caddyfile
