[Unit]
Description=Netball Trials reminders and scheduled communications
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
WorkingDirectory=/opt/netball/netballtrials/deploy/vps
ExecStart=/usr/bin/flock -w 900 /run/lock/netball-trials-operations.lock /usr/bin/docker compose --env-file /opt/netball/trials.env -f compose.yaml --profile jobs run --rm --no-deps trials-reminders
TimeoutStartSec=30min
